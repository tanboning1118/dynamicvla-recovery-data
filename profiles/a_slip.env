#!/usr/bin/env bash
# ===========================================================================
# A 类 · 滑脱后重抓
#
# 物理机制：夹爪命令全程保持闭合（-1），把接触摩擦降到 μ=0.02、质量放大 8 倍，
#           让物体从「指间」滑出去 —— 不是张开夹爪撒手。
#
# 为什么必须是 friction 不是 open：
#   open 模式下夹爪是张开的，标签只能给出 lost，模型学不到「我以为我还握着」
#   这个状态。实测 open 模式滑脱对训练 100% 不可见（0/7 valid），friction 21/21 可学。
#
# 状态轨迹：0→2→3→4→5→10 SLIP→11 SETTLE→12 RECOVER→3→4→5→6→8→9
#
# 实测产出率：24 尝试 → 9 条 = 37.5%
# 单尝试耗时：68 s（含被丢弃的）
# ===========================================================================

PROFILE_NAME="a_slip"
PROFILE_CLASS="A"

# ---- 滑脱注入 ---------------------------------------------------------------
export REC_SLIP=1
export REC_SLIP_MODE=friction          # ★★ 关键。脚本默认值是 open，会毁掉整批
export REC_SLIP_FRICTION=0.02
export REC_SLIP_MASS_SCALE=8           # 摩擦单独不够：Franka 指位置驱动、法向力极大
export REC_SLIP_LIFT_HEIGHT=0.06       # friction 是「从指间滑出」，抬太高会弹跳滚动
export REC_SLIP_STEP_MAX=20
export REC_SLIP_OPEN_TIME=0.20
export REC_SLIP_FRICTION_TIME=1.20
export REC_SLIP_SLIDE_DIST=0.015

# ---- 等待静止 ---------------------------------------------------------------
export REC_SETTLE_MIN_TIME=0.40
export REC_SETTLE_MAX_TIME=5.0         # ★ 默认 3.0；friction 滑出慢，3 s 会误判放弃
export REC_MAX_ATTEMPTS=3              # ★ 默认 2；目标是「最终成功」，多给一次

# ---- 其他注入全部显式关闭（单变量原则）--------------------------------------
export REC_GRASP_JITTER_XY=0           # 实测 12mm/8deg -> 3/3 GIVE_UP，关闭
export REC_GRASP_JITTER_YAW=0
export REC_GRASP_CHECK=0
export REC_MISS_OFFSET=0.0
export REC_DISTURB_AT=-1
export REC_DISTURB_VEL=0.0

# ---- 生成器参数 -------------------------------------------------------------
export GEN_TASK="place"
export GEN_ROBOT="franka"
export GEN_EPISODE_LENGTH="30"
export GEN_EXTRA_FLAGS="--require_slip"   # 必须：丢掉「没滑脱也被留下」的脏样本
export GEN_KEEP_IMPERFECT="0"
export GEN_CHUNK="20"

# ---- 期望指标（供 QA 与 report 比对）----------------------------------------
export EXPECT_YIELD="0.375"
export EXPECT_FRAMES_MEDIAN="169"
export EXPECT_INCIDENT_RATIO="0.40"    # slipping+lost 占帧比例下限
export EXPECT_SM_STATES="10,11,12"     # 必须出现这些状态码