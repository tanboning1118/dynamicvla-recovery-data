#!/usr/bin/env bash
# ===========================================================================
# C 类 · 放偏后二次放置
#
# 这一类**不需要新的注入点** —— 恢复路径状态机里已经有了。
#
# TO_TARGET 状态（place_recovery_sm.py:823）：
#     placed = is_object_placed(obj_pos, obj_size, ctn_pos, ctn_size)
#     if placed:  is_placed = 0
#     else:       is_placed += 1
#     if is_placed >= 5:
#         if attempt >= MAX_ATTEMPTS: GIVE_UP
#         else:                        RESET      ← 自动重试
#
# 即：放置后连续 5 帧判定物体不在容器内 → RESET 重新走完整流程。
#
# ⚠️ 但「靠官方判定自然产生 RESET」在当前配方下不成立（2026-11-02 实测）：
#    官方放置精度是毫米级，is_object_placed 几乎永远为真。demo_d 用原配方
#    8 次尝试保存 5 条，5/5 都不含状态 1，全部是普通成功样本。
#    必须显式把落点横向挪开 REC_PLACE_OFFSET（默认 6 cm），让它真的放偏，
#    is_placed 才会累加到 5 并触发 RESET。产物必须 Post-check 含状态 1。
#
# 🟡 主动注入部分成功、但不稳定（2026-11-02，demo_d2 4 条）：
#    REC_PLACE_OFFSET=0.06 确实让 RESET 出现了，可逐条查触发前状态发现那是
#    「抓取失败 → RESET」反复 4 次，最后一次放置仍然成功（6 cm 偏移对当前容器
#    还不够狠）。真正带 place_failed 的样本是自然放偏产生的（kiwi00d，5 次放置
#    失败重试）。
#    结论：C 类目前靠「自然放偏 + 筛选」产出，稳定但产量取决于容器/物体组合；
#    主动注入这条路要把偏移提到 0.10–0.12 或换小口径容器再验。
#    验证工具：scripts/25_verify_episode.py（打印 RESET 成因细分）。
#
# 状态轨迹（目标）：...→8 PLACE→9 TO_TARGET→1 RESET→2→3→4→5→6→8→9
#
# 产出率：自然筛选约 1/8（demo_c3 里 1 条 / 8 次尝试），主动注入不稳定
# 单尝试耗时：90 s（EP=45 + 多次重试）
# ===========================================================================

PROFILE_NAME="c_place_miss"
PROFILE_CLASS="C"

# ---- 全部注入关闭：靠官方放置判定 + RESET 自然产生 ---------------------------
export REC_SLIP=0
export REC_SLIP_MODE=friction
export REC_SLIP_FRICTION=0.02
export REC_SLIP_MASS_SCALE=1.0
export REC_GRASP_CHECK=0
export REC_MISS_OFFSET=0.0
export REC_GRASP_JITTER_XY=0
export REC_GRASP_JITTER_YAW=0
export REC_DISTURB_AT=-1
export REC_DISTURB_VEL=0.0

# ---- 制造放偏：把落点横向挪开 -----------------------------------------------
export REC_PLACE_OFFSET=0.06           # ★★ 关键。不加这条，放置永远成功、RESET 永不触发

# ---- 关键：给足重试机会 -----------------------------------------------------
export REC_MAX_ATTEMPTS=3              # ★ 必须 ≥2，否则 is_placed>=5 时直接 GIVE_UP
export REC_SETTLE_MIN_TIME=0.40
export REC_SETTLE_MAX_TIME=5.0

# ---- 生成器参数 -------------------------------------------------------------
export GEN_TASK="place"
export GEN_ROBOT="franka"
export GEN_EPISODE_LENGTH="45"         # ★ 二次放置需要更多帧；实测 40 也偏紧
export GEN_EXTRA_FLAGS="--keep_imperfect"
export GEN_KEEP_IMPERFECT="1"
export GEN_CHUNK="20"

# ---- 期望指标 ---------------------------------------------------------------
export EXPECT_YIELD="0.40"             # 待实测校准
export EXPECT_FRAMES_MEDIAN="250"
export EXPECT_INCIDENT_RATIO="0.15"
export EXPECT_SM_STATES="1"            # 必须出现 RESET

# ---- 后置过滤：只保留出现 RESET 的轨迹 --------------------------------------
# 由 scripts/06_run_campaign.py 读 recovery_index.json 做筛选。
# C 类不出现 RESET 的轨迹就是普通成功样本，不是我们想要的。
export POST_FILTER="has_reset"
export POST_FILTER_MIN_RESETS="1"