#!/usr/bin/env bash
# ===========================================================================
# C 类 · 推偏后重新定位
#
# 物理机制：一次性向刚体写侧向速度（默认 0.35 m/s），把物体从机械臂的目标位置推走。
#           机械臂下次接近时物体已不在原处 → 需重新定位。
#
# 触发条件不是固定帧号，而是「机械臂进入 15 cm 且夹爪仍张开」——
# 即 3-3 组推物体的那个时刻。
#
# ⚠️ 为什么不在「已夹住后」推：实测无效。手指会带着物体一起走，画面里看不到位移。
#    必须卡在 grip == OPEN 且接近途中。
#
# ⚠️ REC_SETTLE_MAX_TIME 必须 8.0。扰动后物体会滚很久，默认 3 s 全部判 GIVE_UP
#    （数据里 750 帧有 300–400 帧静止）。
#
# ⚠️ 光推不管用，必须开 REC_DRIFT_TOL（2026-11-02 实测）。状态机每帧按物体
#    「实时位姿」重算 grasp_pos，物体被推走后机械臂只是安静地跟过去，轨迹看起来
#    完全正常：demo_c 10 次尝试保存 5 条，5/5 都不含状态 1（RESET），一条有效
#    的「重定位」都没有。
#
# 🔴 本轮仍未跑通（2026-11-02，共 4 批 20+ 次尝试）。
#    加 DRIFT_TOL=0.04 后 RESET 确实出现了，但逐条查 RESET 的「触发前状态」发现
#    没有一条来自 APPROACH_OBJECT(3)：
#      apple03d  RESET@69/143  from_state=6  (LIFT)        → grasp_failed
#      kiwi00d   RESET@111     from_state=9  (TO_TARGET)   → place_failed
#                RESET@187+    from_state=5  (GRASP)       → grasp_failed ×5
#    也就是说 DRIFT_TOL 闸门没有真正拦住「计划过期」，实际触发 RESET 的是抓取
#    与放置失败。要判这两者必须看触发前状态，只看「含状态 1」会把它们当成 C 类。
#    验证工具：scripts/25_verify_episode.py（会打印 RESET 成因细分）。
#
# 下一步方向（未验证）：DRIFT_TOL 的检查点要挪到 APPROACH_ABOVE / TO_GRASP 阶段，
# 且比较基准应锁定「扰动发生时的物体位姿」而不是每帧实时位姿。
#
# 状态轨迹（目标）：0→2→3→（扰动，计划过期）→1 RESET→2→3→4→5→6→8→9
#
# 产出率：0/20+（未跑通）
# 单尝试耗时：80 s（EP=60 下）
# ===========================================================================

PROFILE_NAME="c_disturb"
PROFILE_CLASS="C"

# ---- 扰动注入 ---------------------------------------------------------------
export REC_DISTURB_AT=0                # 起始帧号门槛（配合距离门控）
export REC_DISTURB_VEL=0.15            # ★★ 实测 0.35 会推出可达范围：3 次尝试 0 保存、全超时
export REC_DISTURB_AXIS=x              # x / y 各半，由 campaign 脚本按 chunk 交替
export REC_DISTURB_RANGE=0.15          # 只在接近途中触发（米）
export REC_DRIFT_TOL=0.04              # ★★ 关键。不加这条，推了等于没推（见顶部实测）

# ---- 等待静止 ---------------------------------------------------------------
export REC_SETTLE_MIN_TIME=0.40
export REC_SETTLE_MAX_TIME=8.0         # ★★ 必须 8.0，默认 3.0 全部 GIVE_UP
export REC_MAX_ATTEMPTS=3

# ---- 其他注入关闭（单变量原则）---------------------------------------------
export REC_SLIP=0                      # 扰动不一定需要滑脱，关掉以免归因变糊
export REC_SLIP_MODE=friction
export REC_SLIP_FRICTION=0.02
export REC_SLIP_MASS_SCALE=1.0
export REC_GRASP_CHECK=0
export REC_MISS_OFFSET=0.0
export REC_GRASP_JITTER_XY=0
export REC_GRASP_JITTER_YAW=0

# ---- 生成器参数 -------------------------------------------------------------
export GEN_TASK="place"
export GEN_ROBOT="franka"
export GEN_EPISODE_LENGTH="60"         # ★★ 实测 40 不够：扰动后要滚很久 + 重定位，EP=60 才收得住
export GEN_EXTRA_FLAGS="--keep_imperfect"
export GEN_KEEP_IMPERFECT="1"
export GEN_CHUNK="20"

# ---- 期望指标 ---------------------------------------------------------------
export EXPECT_YIELD="0.40"             # 待实测校准
export EXPECT_FRAMES_MEDIAN="220"
export EXPECT_INCIDENT_RATIO="0.20"
export EXPECT_SM_STATES="1"            # 必须出现 RESET（说明真的重定位了）