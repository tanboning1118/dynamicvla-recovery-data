#!/usr/bin/env bash
# ===========================================================================
# E 类 · 纯成功对照（负对照）
#
# 作用：防止模型把「有异常 = 应该重试」学成无条件重试。
#
# 如果 E 类样本进训练后，模型在干净轨迹上也开始犹豫/反复试探，
# 说明事故类权重过高 —— 这是唯一能发现该问题的对照组。
#
# 全部注入关闭，参数全 0。状态机走官方 0→9 路径，不出现 1/10/11/12/13。
#
# 实测产出率：3 尝试 → 1 条 = 33%（小样本；官方 baseline place 历史 36.89%）
# 单尝试耗时：30 s
# ===========================================================================

PROFILE_NAME="e_control"
PROFILE_CLASS="E"

# ---- 全部注入关闭 -----------------------------------------------------------
export REC_SLIP=0
export REC_SLIP_MODE=friction
export REC_SLIP_FRICTION=0.02
export REC_SLIP_MASS_SCALE=1.0
export REC_GRASP_CHECK=0
export REC_MISS_OFFSET=0.0
export REC_GRASP_JITTER_XY=0
export REC_GRASP_JITTER_YAW=0
export REC_DISTURB_AT=-1
export REC_DISTURB_VEL=0.0
export REC_MAX_MISSES=0

# ---- 严禁重试 ---------------------------------------------------------------
export REC_MAX_ATTEMPTS=1              # ★ 1 = 不重试。出现 RESET/12 就该丢弃
export REC_SETTLE_MIN_TIME=0.40
export REC_SETTLE_MAX_TIME=3.0

# ---- 生成器参数 -------------------------------------------------------------
export GEN_TASK="place"
export GEN_ROBOT="franka"
export GEN_EPISODE_LENGTH="30"
export GEN_EXTRA_FLAGS="--keep_imperfect"   # E 类本来就无 slip，不能用 require_slip
export GEN_KEEP_IMPERFECT="1"
export GEN_CHUNK="20"

# ---- 期望指标 ---------------------------------------------------------------
export EXPECT_YIELD="0.35"             # 官方 baseline place 成功率 36.89%
export EXPECT_FRAMES_MEDIAN="120"
export EXPECT_INCIDENT_RATIO="0.10"    # 事故类标签应极低（对照的意义就在这）
export EXPECT_SM_STATES="none"         # 不该出现 1/10/11/12/13

# ---- 后置过滤：剔除任何出现异常的轨迹 --------------------------------------
export POST_FILTER="clean_success"
export POST_FILTER_FORBID_STATES="1,10,11,12,13"