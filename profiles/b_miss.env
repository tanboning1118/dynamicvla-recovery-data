#!/usr/bin/env bash
# ===========================================================================
# B 类 · 抓空后重试
#
# 物理机制：首抓加 5 cm 横向偏移 → 手落在物体旁边 → 闭合夹到空气 →
#           抬升 10 帧后物体 z 没涨 → 判定空手 → RECOVER_APPROACH 重抓。
#
# 与 A 类的决定性区别：
#   物体是否被抬起过   A 是（中途滑出） / B **否**（从未离开桌面）
#   检测方式           A 距离渐增      / B **抬升量为零**
#   正确响应           A 等静止再抓    / B **立即**重抓
#
# 状态轨迹：0→2→3→4 GRASP(空)→5 LIFT→12 RECOVER→3→4→5→6→8→9（无 10/11）
#
# ⚠️ REC_SLIP 必须为 0。slip_armed = SLIP_ENABLED and attempt==0 and not slip_done，
#    而 MISS_OFFSET 只加 _grasp_misses 不动 attempt → 重抓后 attempt 仍为 0
#    → 必定再滑脱一次。一条轨迹变 5 阶段（实测 1000 帧 = DOM 的 9 倍），
#    30 s 预算内 0/9 全超时。关掉后 5/6 = 83%。
#
# ⚠️ 必须 --keep_imperfect。纯抓空不含 slip，--require_slip 会把它整条丢掉。
#    代价是「偏移注入但仍抓住了」的干净轨迹也会被保存 → 必须配 POST_FILTER=has_retry
#    后置剔除，否则 B 目录里混进 ordinary success，事故标签密度虚高。
#
# ⚠️ episode 预算必须 45 s（2026-11-02 实测）。30 s 时：
#    6000001/6000005 保存成功（都没抓空）· 6000002/6000004/6000006/6000007
#    真抓空了 → 重抓 → "no placement within 30 s, discarded"。
#    抓空 + 重抓比普通成功多花约 10 s，30 s 预算下真抓空样本 0 存活。
#    改成 45 s 后才有可用的 B 类轨迹。
#
# 实测产出率：6 尝试 → 5 条 = 83%（小样本，量产按 70% 保守估）
#             ——这是「保存率」，其中真抓空比例见 POST_FILTER 后的统计
# 单尝试耗时：45 s
# ===========================================================================

PROFILE_NAME="b_miss"
PROFILE_CLASS="B"

# ---- 抓空注入 ---------------------------------------------------------------
export REC_SLIP=0                      # ★★ 必须 0，见上
export REC_GRASP_CHECK=1               # ★ 开启空抓检测
export REC_MISS_OFFSET=0.05            # ★ 0.04→33% / 0.055~0.065→0%（轨迹过长超时）
export REC_GRASP_CHECK_DELAY=10        # 闭合后 10 帧再判定
export REC_GRASP_MIN_LIFT=0.005        # 物体涨不到 5 mm 即判空
export REC_GRASP_MISS_DIST=0.03        # 空手时 ee-obj 距离判据
export REC_MAX_MISSES=2                # 空抓 2 次后 GIVE_UP
export REC_MAX_ATTEMPTS=3

# ---- 滑脱相关全部关闭 -------------------------------------------------------
export REC_SLIP_MODE=friction          # 显式写，虽然 REC_SLIP=0 时不生效
export REC_SLIP_FRICTION=0.02
export REC_SLIP_MASS_SCALE=1.0
export REC_SETTLE_MIN_TIME=0.40
export REC_SETTLE_MAX_TIME=3.0
export REC_GRASP_JITTER_XY=0
export REC_GRASP_JITTER_YAW=0
export REC_DISTURB_AT=-1
export REC_DISTURB_VEL=0.0

# ---- 生成器参数 -------------------------------------------------------------
export GEN_TASK="place"
export GEN_ROBOT="franka"
export GEN_EPISODE_LENGTH="45"     # ★ 30 不够：抓空+重抓多花约 10 s，30 s 下真抓空样本全被丢
export GEN_EXTRA_FLAGS="--keep_imperfect"   # ★ 必须，不能用 --require_slip
export GEN_KEEP_IMPERFECT="1"
export GEN_CHUNK="20"

# ---- 期望指标 ---------------------------------------------------------------
export EXPECT_YIELD="0.70"             # 实测 83%，保守取 70%
export EXPECT_FRAMES_MEDIAN="169"
export EXPECT_INCIDENT_RATIO="0.30"
export EXPECT_SM_STATES="12"           # 只要求 12；10/11 不该出现（出现说明 slip 没关干净）

# ---- 后置过滤：只保留真的抓空了又重抓的轨迹 ---------------------------------
# 由 scripts/06_run_campaign.py 读，要求 sm_state 同时含 12（RECOVER_APPROACH）
# 与 9（TO_TARGET，即最终真的放到位）。见本文件顶部 2026-11-02 的实测记录。
export POST_FILTER="has_retry"
